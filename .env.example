CHEFAI_APP_NAME=ChefAI
CHEFAI_ENVIRONMENT=local

CHEFAI_QDRANT_URL=http://localhost:6333
CHEFAI_QDRANT_API_KEY=
CHEFAI_QDRANT_COLLECTION=recipes

CHEFAI_DENSE_MODEL=BAAI/bge-small-en-v1.5
CHEFAI_SPARSE_MODEL=Qdrant/bm25
CHEFAI_DENSE_VECTOR_SIZE=384

# Cross-encoder reranking is off by default: it scores passage relevance to a
# question, not whether a recipe can be cooked, and it costs latency per search.
CHEFAI_RERANK_ENABLED=false
CHEFAI_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Retrieval scores are tie-breakers over the deterministic ingredient score.
CHEFAI_HYBRID_WEIGHT=0.15
CHEFAI_RERANK_WEIGHT=0.10

CHEFAI_HYBRID_CANDIDATE_LIMIT=60
CHEFAI_DEFAULT_LIMIT=10
CHEFAI_MAX_LIMIT=50
